# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
# Repo-wide rules. App-specific rules live next to each app (e.g. apps/mobile/.gitignore).

# dependencies
node_modules/

# build output
dist/
coverage/
*.tsbuildinfo

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# env files — never commit
.env
.env.*
!.env.example

# keys, signing and credentials
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
credentials.json
google-services.json
GoogleService-Info.plist

# OS / IDE
.DS_Store
.idea/
