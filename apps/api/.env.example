# Copy to apps/api/.env (gitignored) and fill in. Never commit real values.

NODE_ENV=development
# 127.0.0.1 keeps the API local. Use 0.0.0.0 only to reach it from a phone on your LAN.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Development database (infra/docker-compose.yml, service "postgres", port 5434 to avoid clashing with other local Postgres servers). Same password as infra/.env.
DATABASE_URL=postgres://nexa:change-me@127.0.0.1:5434/nexa

# Development-only owner token for the app/owner endpoints (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The API refuses to start with NODE_ENV=production while this is the only auth.
OWNER_TOKEN=replace-with-a-random-32-plus-character-value

# Test database (service "postgres-test"). Tests wipe it; its name must end in "_test".
TEST_DATABASE_URL=postgres://nexa:change-me@127.0.0.1:5433/nexa_test
